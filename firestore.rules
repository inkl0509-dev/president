rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public leaderboard: anyone can read, anyone can add a well-formed entry,
    // nobody can edit or delete entries from the browser.
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'country', 'party', 'score', 'title', 'terms', 'approval', 'createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 24
                    && request.resource.data.country is string && request.resource.data.country.size() <= 40
                    && request.resource.data.party in ['prog', 'cons', 'green', 'lib']
                    && request.resource.data.title is string && request.resource.data.title.size() <= 40
                    && request.resource.data.score is int
                    && request.resource.data.score >= -2000 && request.resource.data.score <= 5000
                    && request.resource.data.terms is int && request.resource.data.terms >= 0 && request.resource.data.terms <= 2
                    && request.resource.data.approval is int
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    // Register of game names, so two games cannot have the same name.
    match /gamenames/{slug} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['gid', 'name', 'at']);
      allow update: if request.resource.data.keys().hasOnly(['gid', 'name', 'at', 'freed'])
                    && (resource.data.gid == null || request.resource.data.gid == null);
      allow delete: if false;
    }
    // Online multiplayer games. Players are anonymous (no sign-in), so anyone with the
    // site can create and join games. Documents are size-limited; nobody can delete.
    match /games/{gameId} {
      allow read: if true;
      allow create, update: if request.resource.data.size() < 60;
      allow delete: if false;
      match /players/{playerId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['name', 'party', 'role', 'joined', 'campaign', 'volunteer', 'response', 'seen', 'look', 'live', 'delVote']);
        allow delete: if false;
      }
      match /acts/{actId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'post', 'kind', 'type', 'payload', 'text', 'status', 'ts', 'turn'])
                      && (!('text' in request.resource.data) || request.resource.data.text.size() <= 400);
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'note']);
        allow delete: if false;
      }
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public leaderboard: anyone can read, anyone can add a well-formed entry,
    // nobody can edit or delete entries from the browser.
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'country', 'party', 'score', 'title', 'terms', 'approval', 'createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 24
                    && request.resource.data.country is string && request.resource.data.country.size() <= 40
                    && request.resource.data.party in ['prog', 'cons', 'green', 'lib']
                    && request.resource.data.title is string && request.resource.data.title.size() <= 40
                    && request.resource.data.score is int
                    && request.resource.data.score >= -2000 && request.resource.data.score <= 5000
                    && request.resource.data.terms is int && request.resource.data.terms >= 0 && request.resource.data.terms <= 2
                    && request.resource.data.approval is int
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
